# Copy this file to .env.docker and fill in real provider credentials.
# Public endpoints can be used directly. Host-local endpoints should use host.docker.internal.

# Docker build defaults. Keep linux/amd64 for Windows Docker Desktop unless you know
# your target host needs a different platform. Change the registry if a mirror returns EOF.
NEWMAN_DOCKER_PLATFORM=linux/amd64
NEWMAN_DOCKER_REGISTRY=docker.m.daocloud.io/library

NEWMAN_MODELS_PRIMARY_TYPE=openai_compatible
NEWMAN_MODELS_PRIMARY_MODEL=gpt-4.1-mini
NEWMAN_MODELS_PRIMARY_ENDPOINT=https://api.openai.com/v1
NEWMAN_MODELS_PRIMARY_API_KEY=your_api_key_here
NEWMAN_MODELS_PRIMARY_CONTEXT_WINDOW=100000
NEWMAN_MODELS_PRIMARY_TIMEOUT=60
NEWMAN_MODELS_PRIMARY_MAX_TOKENS=4096
NEWMAN_MODELS_PRIMARY_TEMPERATURE=0.2

NEWMAN_MODELS_MULTIMODAL_TYPE=openai_compatible
NEWMAN_MODELS_MULTIMODAL_MODEL=gpt-4.1
NEWMAN_MODELS_MULTIMODAL_ENDPOINT=https://api.openai.com/v1
NEWMAN_MODELS_MULTIMODAL_API_KEY=your_api_key_here
NEWMAN_MODELS_MULTIMODAL_CONTEXT_WINDOW=32000

# Optional Google search integration.
SERPAPI_API_KEY=

# Optional proxy settings for corporate networks.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,postgres,backend,frontend,host.docker.internal

# Feishu inbound channel: Feishu -> Newman through the Python Channel SDK.
# Create a Feishu self-built app, enable bot + long-connection events, subscribe im.message.receive_v1,
# then fill in the app credentials here.
NEWMAN_CHANNELS__FEISHU__ENABLED=true
NEWMAN_CHANNELS__FEISHU__TRANSPORT=channel_sdk
NEWMAN_CHANNELS__FEISHU__APP_ID=
NEWMAN_CHANNELS__FEISHU__APP_SECRET=
NEWMAN_CHANNELS__FEISHU__DOMAIN=https://open.feishu.cn
NEWMAN_CHANNELS__FEISHU__DEFAULT_TURN_APPROVAL_MODE=auto_allow
NEWMAN_CHANNELS__FEISHU__REQUIRE_MENTION_IN_GROUP=true
NEWMAN_CHANNELS__FEISHU__ALLOWED_CHAT_IDS=
NEWMAN_CHANNELS__FEISHU__ALLOWED_USER_OPEN_IDS=
NEWMAN_CHANNELS__FEISHU__REPLY_TIMEOUT_SECONDS=20
NEWMAN_CHANNELS__FEISHU__DEDUP_TTL_SECONDS=600

# Feishu CLI plugin: Newman -> Feishu through the system lark-cli binary.
# The backend image installs lark-cli. Docker Compose mounts $HOME/.lark-cli and
# $HOME/.local/share/lark-cli into the container so it can reuse host login state.
NEWMAN_LARK_DEFAULT_IM_USER_ID=
# bot or user; leave empty to require an explicit --as in each send task.
NEWMAN_LARK_DEFAULT_IM_IDENTITY=

# Legacy/dev-only Feishu CLI event consumer. Current inbound uses channel_sdk above.
NEWMAN_FEISHU_CLI_CHANNEL_ENABLED=false
NEWMAN_FEISHU_CLI_BIN=lark-cli
NEWMAN_FEISHU_CLI_IDENTITY=bot
NEWMAN_FEISHU_CLI_EVENT_KEY=im.message.receive_v1
