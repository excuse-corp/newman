# Newman runtime configuration
# Copy this file to `.env` and adjust values as needed.
# Recommended runtime:
#   conda activate newman
#   ./scripts/dev/start_postgres.sh
#   uvicorn backend.main:app --reload

# Server
NEWMAN_SERVER_HOST=0.0.0.0
NEWMAN_SERVER_PORT=8005

# Models
NEWMAN_MODELS_PRIMARY_TYPE=openai_compatible
NEWMAN_MODELS_PRIMARY_MODEL=gpt-4.1-mini
NEWMAN_MODELS_PRIMARY_ENDPOINT=https://api.openai.com/v1
NEWMAN_MODELS_PRIMARY_API_KEY=your_api_key_here
NEWMAN_MODELS_PRIMARY_CONTEXT_WINDOW=100000
NEWMAN_MODELS_PRIMARY_TIMEOUT=60
NEWMAN_MODELS_PRIMARY_MAX_TOKENS=4096
NEWMAN_MODELS_PRIMARY_TEMPERATURE=0.2

NEWMAN_MODELS_MULTIMODAL_TYPE=openai_compatible
NEWMAN_MODELS_MULTIMODAL_MODEL=gpt-4.1
NEWMAN_MODELS_MULTIMODAL_ENDPOINT=https://api.openai.com/v1
NEWMAN_MODELS_MULTIMODAL_API_KEY=your_api_key_here
NEWMAN_MODELS_MULTIMODAL_CONTEXT_WINDOW=32000

NEWMAN_MODELS_EMBEDDING_TYPE=openai_compatible
NEWMAN_MODELS_EMBEDDING_MODEL=text-embedding-3-large
NEWMAN_MODELS_EMBEDDING_ENDPOINT=https://api.openai.com/v1
NEWMAN_MODELS_EMBEDDING_API_KEY=your_api_key_here
NEWMAN_MODELS_EMBEDDING_DIMENSION=4096

NEWMAN_MODELS_RERANKER_TYPE=openai_compatible
NEWMAN_MODELS_RERANKER_MODEL=bge-reranker-v2-m3
NEWMAN_MODELS_RERANKER_ENDPOINT=http://localhost:8001/v1
NEWMAN_MODELS_RERANKER_API_KEY=
NEWMAN_MODELS_RERANKER_CONTEXT_WINDOW=32000

# Runtime
NEWMAN_RUNTIME_MAX_TOOL_DEPTH=20
NEWMAN_RUNTIME_CONTEXT_COMPRESS_THRESHOLD=0.8
NEWMAN_RUNTIME_CONTEXT_CRITICAL_THRESHOLD=0.92

# RAG
# Metadata and chunk mappings go to PostgreSQL.
# Vector index goes to Chroma persistent storage.
NEWMAN_RAG_POSTGRES_DSN=postgresql://postgres@127.0.0.1:65437/newman
NEWMAN_RAG_CHROMA_COLLECTION=knowledge_chunks
NEWMAN_PATHS_CHROMA_DIR=backend_data/chroma

# Sandbox
NEWMAN_SANDBOX_ENABLED=false
NEWMAN_SANDBOX_TIMEOUT=30

# SerpApi Google Search
# google_search 工具会优先读取 SERPAPI_API_KEY，也兼容 SERPAPI_KEY / NEWMAN_SERPAPI_API_KEY。
SERPAPI_API_KEY=your_serpapi_api_key_here

# Teable integration
TEABLE_BASE_URL=http://127.0.0.1:13000
TEABLE_API_TOKEN=
TEABLE_NEWMAN_SPACE_ID=
TEABLE_NEWMAN_BASE_ID=

# Channels
NEWMAN_CHANNELS__FEISHU__ENABLED=true
NEWMAN_CHANNELS__FEISHU__TRANSPORT=channel_sdk
NEWMAN_CHANNELS__FEISHU__APP_ID=
NEWMAN_CHANNELS__FEISHU__APP_SECRET=
NEWMAN_CHANNELS__FEISHU__DOMAIN=https://open.feishu.cn
NEWMAN_CHANNELS__FEISHU__DEFAULT_TURN_APPROVAL_MODE=auto_allow
NEWMAN_CHANNELS__FEISHU__REQUIRE_MENTION_IN_GROUP=true
# Optional comma-separated allowlists, for example: oc_xxx,oc_yyy
NEWMAN_CHANNELS__FEISHU__ALLOWED_CHAT_IDS=
NEWMAN_CHANNELS__FEISHU__ALLOWED_USER_OPEN_IDS=
NEWMAN_CHANNELS__FEISHU__REPLY_TIMEOUT_SECONDS=20
NEWMAN_CHANNELS__FEISHU__DEDUP_TTL_SECONDS=600
NEWMAN_CHANNELS__WECOM__ENABLED=true
NEWMAN_CHANNELS__WECOM__WEBHOOK_TOKEN=

# Optional override for feishu-cli plugin helper commands.
# Leave empty unless you want lark-cli +messages-send to default to a specific bot user_id.
NEWMAN_LARK_DEFAULT_IM_USER_ID=

# Legacy/dev-only Feishu CLI event consumer.
# Current Feishu -> Newman inbound uses lark-channel-sdk through channels.feishu.transport=channel_sdk.
NEWMAN_FEISHU_CLI_CHANNEL_ENABLED=false
NEWMAN_FEISHU_CLI_BIN=lark-cli
NEWMAN_FEISHU_CLI_IDENTITY=bot
NEWMAN_FEISHU_CLI_EVENT_KEY=im.message.receive_v1
NEWMAN_FEISHU_CLI_READY_TIMEOUT_SECONDS=20
